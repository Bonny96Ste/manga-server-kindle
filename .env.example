MANGADL_STACK_PATH=/opt/portainer/mangabridge/server
MANGADL_PORT=8095
MANGADL_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=0

# Kindle / KOReader API. Existing MangaBridge Kindle clients remain compatible.
KINDLE_API_TOKEN=replace-with-a-long-random-token
KINDLE_PROFILE_USERNAME=
KINDLE_PDF_MODE=original

# Optional legacy HTTP Basic fallback for the Kindle API only.
MANGADL_USERNAME=
MANGADL_PASSWORD=

WATCH_SCAN_SECONDS=300
PDF_RENDER_SCALE=1.6
KINDLE_CACHE_MAX_MB=2048
KINDLE_COVER_FIT=contain
